<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- librdkafka ships Windows x64 binaries, not Windows ARM64 binaries. -->
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <NoWarn>$(NoWarn);ASPIREHOSTINGPYTHON001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Kafka" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Python" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventProducer\EventProducer.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
