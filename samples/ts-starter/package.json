{
  "name": "ts-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint apphost.mts",
    "predev": "npm run lint",
    "dev": "aspire run",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.apphost.json",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "watch": "tsc --watch -p tsconfig.apphost.json"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
